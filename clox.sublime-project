{
	"folders":
	[
		{
			"path": ".",
		},
		{
			"path": "../jai"
		}
	],
	"build_systems":
	[
		{
			"name": "jai",
			"working_dir": "${project_path}",
			"file_regex": "^(..[^\\()]*):([0-9]+),?([0-9]+)?: (.*)$", // clang regex

			"variants":
			[
				{
					"name" : "build",
					"shell_cmd" : "jai clox.jai -exe clox",
				},
				{
					"name" : "build & run",
					"shell_cmd" : "jai clox.jai -exe clox & clox.exe",
				},
			]
		}
	]
}
